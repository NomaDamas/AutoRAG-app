{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/renderer", "src/shared", "src/preview/shared", "src/preview/ui", "test/preview-markdown-html.test.ts", "test/row-pipeline.test.tsx", "test/ui-path-bar-edit.test.tsx", "test/ui-context-menu-a11y.test.tsx", "test/ui-toolbar-menu-trigger.test.tsx", "test/ui-version-tag.test.tsx", "test/ui-evidence-excerpt.test.tsx", "test/onboarding-embedding-step.test.tsx", "test/model-download-panel.test.tsx", "test/onboarding-folders-smart.test.tsx", "test/hister-calendar-ui.test.tsx", "test/support/onboarding-ctx.ts", "test/interface-language.test.ts"],
	"exclude": ["node_modules", "out"]
}
