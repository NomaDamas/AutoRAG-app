#!/bin/sh
# DAZZI-CLI-LAUNCHER (macOS): the `dazzi` command, shipped inside the app at Contents/Resources/bin/dazzi.
#
#   dazzi [path...]               open folders (and show files in their folder) in Dazzi, like `open` does for Finder
#   dazzi --ask "question" [path...]   ask AI Search the question in a new tab, the paths attached
#   dazzi                         bring Dazzi to the front
#
# It only builds the request the OS file menu already sends (`--autorag-request=open` or `=ask`, one
# `--autorag-path=` per item, `--autorag-query=` for a question) and starts the app's own executable with it.
# A running Dazzi receives the request over its local socket and this process exits; with none running, the
# process becomes the app.
# DAZZI_USER_DATA_DIR aims the request at another profile (development, QA).

MAX_PATHS=200

usage() {
	cat <<'USAGE'
Usage: dazzi [--] [path...]
       dazzi --ask QUESTION [--] [path...]

Open folders in Dazzi, or show files selected in their folder.
With --ask, ask AI Search the question in a new tab, the paths attached.
With no path, bring Dazzi to the front.

  --ask QUESTION   ask AI Search (also --ask=QUESTION)
  -h, --help       show this help
USAGE
}

# Resolve the symlinks this launcher was reached through (Homebrew, ~/.local/bin, /usr/local/bin) to the real file.
self=$0
while [ -h "$self" ]; do
	target=$(readlink "$self")
	case $target in
		/*) self=$target ;;
		*) self=$(dirname -- "$self")/$target ;;
	esac
done
bin_dir=$(cd -- "$(dirname -- "$self")" && pwd) || exit 1
app=$(cd -- "$bin_dir/../../.." && pwd) || exit 1
exe="$app/Contents/MacOS/Dazzi"

if [ ! -x "$exe" ]; then
	echo "dazzi: $app is not a complete Dazzi.app" >&2
	exit 1
fi

# A launcher started from an Electron/Node tool would otherwise turn the app into plain Node.
unset ELECTRON_RUN_AS_NODE

ask=
question=
while [ $# -gt 0 ]; do
	case $1 in
		-h | --help)
			usage
			exit 0
			;;
		--ask)
			ask=1
			question=${2-}
			[ $# -gt 1 ] && shift
			shift
			;;
		--ask=*)
			ask=1
			question=${1#--ask=}
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			echo "dazzi: unknown option $1" >&2
			usage >&2
			exit 2
			;;
		*) break ;;
	esac
done

if [ -n "$ask" ]; then
	case $question in
		*[![:space:]]*) ;;
		*)
			echo "dazzi: --ask needs a question" >&2
			usage >&2
			exit 2
			;;
	esac
fi

if [ $# -eq 0 ] && [ -z "$ask" ]; then
	exec open "$app"
fi

if [ $# -gt "$MAX_PATHS" ]; then
	echo "dazzi: too many paths (the limit is $MAX_PATHS)" >&2
	exit 1
fi

status=0
found=0
count=$#
i=0
while [ $i -lt "$count" ]; do
	path=$1
	shift
	i=$((i + 1))
	if [ -d "$path" ]; then
		abs=$(cd -- "$path" && pwd)
	elif [ -e "$path" ] || [ -h "$path" ]; then
		dir=$(cd -- "$(dirname -- "$path")" && pwd)
		case $dir in
			/) abs=/$(basename -- "$path") ;;
			*) abs=$dir/$(basename -- "$path") ;;
		esac
	else
		echo "dazzi: $path: No such file or directory" >&2
		status=1
		continue
	fi
	set -- "$@" "--autorag-path=$abs"
	found=$((found + 1))
done

# The loop shifted every input path off and appended one flag per existing path.
if [ "$found" -eq 0 ] && [ -z "$ask" ]; then
	exit "$status"
fi

if [ -n "$ask" ]; then
	set -- --autorag-request=ask "--autorag-query=$question" "$@"
else
	set -- --autorag-request=open "$@"
fi
if [ -n "${DAZZI_USER_DATA_DIR-}" ]; then
	set -- "--user-data-dir=$DAZZI_USER_DATA_DIR" "$@"
fi

# Detached: with no app running this process becomes the app and must outlive the terminal.
nohup "$exe" "$@" >/dev/null 2>&1 </dev/null &
exit "$status"
