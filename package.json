{
	"name": "@autorag/app",
	"version": "0.1.0",
	"private": true,
	"description": "AutoRAG — a Finder-style desktop app built on the public AutoRAG librarian.",
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"preinstall": "node scripts/sync-librarian.mjs",
		"postinstall": "node scripts/ensure-electron.mjs",
		"dev": "electron-vite dev",
		"predev": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs && node scripts/ensure-electron.mjs",
		"prebuild": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs",
		"build": "electron-vite build",
		"pretest": "node scripts/sync-librarian.mjs",
		"test": "vitest run --exclude '**/.upstream/**'",
		"pretypecheck": "node scripts/sync-librarian.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test:e2e": "electron-vite build && playwright test",
		"qa": "node scripts/qa-vm.mjs",
		"qa:vm:setup": "node scripts/qa-vm.mjs setup",
		"qa:vm:status": "node scripts/qa-vm.mjs status",
		"qa:vm:gc": "node scripts/qa-vm.mjs gc"
	},
	"dependencies": {
		"@autorag/librarian": "file:./.upstream/autorag",
		"@base-ui/react": "^1.8.0",
		"@earendil-works/pi-ai": "0.86.1",
		"@earendil-works/pi-coding-agent": "0.86.1",
		"@parcel/watcher": "^2.6.0",
		"@rhwp/core": "0.8.6",
		"clsx": "^2.1.1",
		"docx-preview": "^0.4.1",
		"exifr": "^7.1.3",
		"fflate": "^0.8.3",
		"heic2any": "^0.0.4",
		"highlight.js": "^11.12.0",
		"i18next": "^26.4.2",
		"libarchive-wasm": "1.2.0",
		"lucide-react": "^1.49.0",
		"marked": "^18.0.14",
		"music-metadata": "^11.16.1",
		"pdfjs-dist": "^6.3.289",
		"radix-ui": "^1.6.7",
		"react-i18next": "^17.0.16",
		"simple-icons": "^16.34.0",
		"spring-easing": "^2.3.3",
		"tailwind-merge": "^3.7.0",
		"utif": "^3.1.0",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.4.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"electron": "^44.4.5",
		"electron-vite": "^5.0.0",
		"happy-dom": "^20.14.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "4.3.3",
		"typescript": "^7.0.2",
		"vite": "^7.0.0",
		"vitest": "^5.0.2"
	}
}
