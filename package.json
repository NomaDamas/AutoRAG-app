{
	"name": "@autorag/app",
	"version": "0.1.0",
	"private": true,
	"license": "FSL-1.1-MIT",
	"description": "Dazzi powered by AutoRAG — a Finder-style desktop app built on the public AutoRAG librarian.",
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"preinstall": "node scripts/sync-librarian.mjs",
		"postinstall": "node scripts/ensure-electron.mjs",
		"dev": "electron-vite dev",
		"predev": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs && node scripts/ensure-electron.mjs",
		"prebuild": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs",
		"build": "electron-vite build",
		"pretest": "node scripts/sync-librarian.mjs",
		"test": "vitest run --exclude '**/.upstream/**'",
		"pretypecheck": "node scripts/sync-librarian.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test:e2e": "electron-vite build && playwright test",
		"release:stage": "node scripts/release/stage-tools.mjs",
		"release:pack:mac": "electron-builder --mac --config electron-builder.config.mjs",
		"release:pack:win": "electron-builder --win --config electron-builder.config.mjs",
		"qa": "node scripts/qa-vm.mjs",
		"qa:vm:setup": "node scripts/qa-vm.mjs setup",
		"qa:vm:status": "node scripts/qa-vm.mjs status",
		"qa:vm:gc": "node scripts/qa-vm.mjs gc"
	},
	"dependencies": {
		"@autorag/librarian": "file:./.upstream/librarian-package",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@parcel/watcher": "^2.6.0",
		"@sentry/electron": "^8.3.0",
		"ag-psd": "^34.1.0",
		"cfb": "1.2.2",
		"electron-updater": "^6.8.11",
		"exifr": "^7.1.3",
		"fflate": "^0.8.3",
		"hyparquet": "^1.32.0",
		"hyparquet-compressors": "^1.1.2",
		"kordoc": "^4.24.21",
		"libarchive-wasm": "1.2.0",
		"lzma-wasm": "1.0.7",
		"music-metadata": "^12.3.2",
		"pdf-lib": "1.17.1",
		"posthog-node": "^5.60.0",
		"typebox": "1.4.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@base-ui/react": "^1.8.0",
		"@playwright/test": "^1.64.1",
		"@rhwp/core": "0.8.7",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"approx-string-match": "2.0.1",
		"clsx": "^2.1.1",
		"docx-preview": "^0.4.1",
		"electron": "^45.1.0",
		"electron-builder": "26.18.0",
		"electron-vite": "^6.0.0",
		"happy-dom": "^21.0.4",
		"heic2any": "^0.0.4",
		"highlight.js": "^11.12.0",
		"hyparquet-writer": "^0.18.0",
		"i18next": "^26.5.11",
		"lucide-react": "^1.64.0",
		"marked": "^18.1.2",
		"pdfjs-dist": "^6.4.299",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.9",
		"simple-icons": "^16.36.0",
		"spring-easing": "^2.3.3",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "4.3.3",
		"typescript": "^7.0.2",
		"utif": "^3.1.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
