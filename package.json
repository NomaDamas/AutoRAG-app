{
	"name": "@autorag/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"preinstall": "node scripts/sync-librarian.mjs",
		"postinstall": "node scripts/ensure-electron.mjs",
		"dev": "electron-vite dev",
		"predev": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs && node scripts/ensure-electron.mjs",
		"prebuild": "node scripts/sync-librarian.mjs && node scripts/require-dupey.mjs",
		"build": "electron-vite build",
		"pretest": "node scripts/sync-librarian.mjs",
		"test": "vitest run --exclude '**/.upstream/**'",
		"pretypecheck": "node scripts/sync-librarian.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test:e2e": "electron-vite build && playwright test"
	},
	"dependencies": {
		"@autorag/librarian": "file:./.upstream/autorag",
		"clsx": "^2.1.1",
		"docx-preview": "^0.4.1",
		"fflate": "^0.8.3",
		"heic2any": "^0.0.4",
		"highlight.js": "^11.12.0",
		"lucide-react": "^1.49.0",
		"marked": "^18.0.14",
		"pdfjs-dist": "^6.3.289",
		"radix-ui": "^1.6.7",
		"spring-easing": "^2.3.3",
		"tailwind-merge": "^3.7.0",
		"utif": "^3.1.0",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.4.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"electron": "^44.4.5",
		"electron-vite": "^5.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "4.3.3",
		"typescript": "^7.0.2",
		"vite": "^7.0.0",
		"vitest": "^5.0.2"
	}
}
