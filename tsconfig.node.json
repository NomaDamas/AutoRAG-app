{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/main", "src/preload", "src/shared", "src/preview/shared", "src/preview/node", "test", "electron.vite.config.ts"],
	"exclude": ["node_modules", "out", "test/preview-markdown-html.test.ts", "test/manual-qa-platform.test.ts", "test/qa-vm-slots.test.ts", "test/qa-vm-plan.test.ts", "test/release-update-feed.test.ts", "test/release-cask.test.ts", "test/row-pipeline.test.tsx", "test/ui-path-bar-edit.test.tsx", "test/ui-context-menu-a11y.test.tsx", "test/ui-version-tag.test.tsx", "test/ui-evidence-excerpt.test.tsx", "test/onboarding-embedding-step.test.tsx"]
}
